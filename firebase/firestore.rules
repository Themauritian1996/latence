rules_version = '2';
// Latence — accès sur invitation seulement.
// - Les administrateurs (ci-dessous) gèrent la liste « allowed ».
// - Chaque utilisateur invité ne voit que ses propres données (users/{uid}).
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function email() { return request.auth.token.email.lower(); }
    function verified() { return request.auth.token.email_verified == true; }
    function isAdmin() {
      return signedIn() && verified() && email() in ['kasaskuengric@gmail.com', 'cahyan@hotmail.fr'];
    }
    function invited() {
      return signedIn() && verified() &&
        (isAdmin() || exists(/databases/$(database)/documents/allowed/$(email())));
    }

    match /allowed/{e} {
      allow read: if isAdmin() || (signedIn() && verified() && e == email());
      allow write: if isAdmin() && e == e.lower();
    }

    match /users/{uid} {
      allow read, write: if invited() && request.auth.uid == uid;
      match /cases/{caseId} {
        allow read, write: if invited() && request.auth.uid == uid;
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
